{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema/page.schema.json",
  "title": "Wiki page YAML header (everything except providers and sources)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title",
    "summary",
    "page_status"
  ],
  "properties": {
    "type": {
      "enum": [
        "overview",
        "approval-model",
        "rail",
        "build",
        "comparison",
        "analysis",
        "changelog",
        "gaps",
        "guide",
        "payment",
        "personal-money"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "page_status": {
      "enum": [
        "current",
        "stale",
        "archived"
      ]
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Changelog entries only."
    }
  }
}
